# Copy to .env.local for local overrides (not needed for the default
# localhost setup - only required when pointing this frontend at
# deployed/non-default backend URLs).
#
# These must be prefixed NEXT_PUBLIC_ to be readable in the browser -
# Next.js only exposes env vars with that prefix to client-side code.

NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:5003
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:5004
