# Shared config for `docker compose up`, loaded automatically from a
# file named `.env` in this directory (not read by the services
# themselves when run outside Docker - see backend/*/.env.example).
#
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env

# Signs and verifies JWTs. Must be identical to JWT_SECRET in
# backend/user/.env and backend/chat/.env - docker-compose.yml
# injects this value into both services so they always agree.
JWT_SECRET=replace_with_a_long_random_string

# Credentials for the rabbitmq container, also injected into
# user-service and mail-service.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Origin the frontend is served from; used for CORS on both backend
# services.
CLIENT_URL=http://localhost:3000
