# Copy to .env and fill in real values:
#   cp .env.example .env
#
# MONGO_URI, JWT_SECRET, USER_SERVICE and CLIENT_URL are only used
# when running this service directly (npm run dev / npm start) -
# under docker-compose those are supplied by docker-compose.yml / the
# root .env instead. Cloudinary credentials are always read from
# this file, in both modes.

PORT=5004
MONGO_URI=mongodb://localhost:27017

# Must match JWT_SECRET in backend/user/.env.example - tokens are
# issued by user-service and verified here with the same secret.
JWT_SECRET=replace_with_a_long_random_string

# Base URL of the user-service, used to fetch profile info for chats.
USER_SERVICE=http://localhost:5003

# Origin(s) allowed to call this API (CORS). Comma-separate for multiple.
CLIENT_URL=http://localhost:3000

# Cloudinary credentials for chat image uploads.
Cloud_Name=your_cloudinary_cloud_name
Api_key=your_cloudinary_api_key
Api_Secret=your_cloudinary_api_secret
