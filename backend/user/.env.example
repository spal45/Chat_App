# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Only used when running this service directly (npm run dev / npm start).
# Under docker-compose, MONGO_URI, REDIS_URL, Rabbitmq_*, JWT_SECRET and
# CLIENT_URL are supplied by docker-compose.yml / the root .env instead.

PORT=5003

MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# Either set RABBITMQ_URL (a full amqp:// or amqps:// connection string,
# e.g. from CloudAMQP) or the three discrete Rabbitmq_* vars below - not
# both. RABBITMQ_URL takes priority if set.
RABBITMQ_URL=
Rabbitmq_Host=localhost
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Must match JWT_SECRET in backend/chat/.env.example - chat-service
# verifies tokens signed by this service using the same secret.
JWT_SECRET=replace_with_a_long_random_string

# Origin(s) allowed to call this API (CORS). Comma-separate for multiple.
CLIENT_URL=http://localhost:3000

# Optional: a public demo account that gets a fixed OTP and skips real
# email delivery, so anyone can try the app without a real inbox. Only
# this exact email is special-cased - leave both unset to disable.
DEMO_EMAIL=
DEMO_OTP=
