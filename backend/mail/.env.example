# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Rabbitmq_* is only used when running this service directly
# (npm run dev / npm start) - under docker-compose it's supplied by
# docker-compose.yml / the root .env instead. SMTP credentials are
# always read from this file, in both modes.

PORT=5005

Rabbitmq_Host=localhost
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Gmail SMTP credentials used to send OTP emails.
# SMTP_PASSWORD must be a Gmail "app password", not your account password.
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
